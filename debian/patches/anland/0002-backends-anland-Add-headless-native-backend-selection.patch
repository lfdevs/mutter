diff --git a/src/backends/anland/meta-backend-anland.h b/src/backends/anland/meta-backend-anland.h
new file mode 100644
index 0000000..746e550
--- /dev/null
+++ b/src/backends/anland/meta-backend-anland.h
@@ -0,0 +1,11 @@
+/* -*- mode: C; c-file-style: "gnu"; indent-tabs-mode: nil; -*- */
+
+#pragma once
+
+#include "backends/native/meta-backend-native-private.h"
+
+#define META_TYPE_BACKEND_ANLAND (meta_backend_anland_get_type ())
